{
  "name": "pohang-opinion-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "tsx --test tests/domain.test.ts tests/logic.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run build",
    "test:integration": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/integration/api.test.ts",
    "test:e2e": "playwright test",
    "tiles:test": "node tests/e2e/tile-server.mjs",
    "operator:local": "node --env-file=.env.local scripts/create-local-operator.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "leaflet": "1.9.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.56.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
