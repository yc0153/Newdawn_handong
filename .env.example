# Copy to .env.local. Never insert real secrets into this example file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
# 32자 이상 임의 값 (예: openssl rand -hex 32)
RATE_LIMIT_HMAC_SECRET=
# 운영 필수: 배포 플랫폼이 보장하는 클라이언트 IP 헤더 이름(예: x-real-ip). 비우면 운영 등록이 열리지 않는다.
TRUSTED_CLIENT_IP_HEADER=
# 지도 공급자 확정 후 입력. 비우면 next dev에서만 OSM 개발용 타일을 쓰고, 운영 빌드에서는 지도 대신 안내를 표시한다.
# 카카오 지도(로드뷰·주소 검색 포함). JavaScript 키만 넣는다(REST/Admin 키 금지). 비우면 아래 타일 지도를 쓴다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 검수용 가짜 SDK 주소로 바꿀 때만 사용
NEXT_PUBLIC_KAKAO_SDK_URL=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# 선택: 헤더에 표시할 환경 이름(예: 로컬 개발, 시험 운영). 운영에서는 비운다.
NEXT_PUBLIC_ENV_LABEL=
# 선택: 학교가 확정한 수집 지역 이름. 확정 전에는 비운다.
NEXT_PUBLIC_AREA_LABEL=
# 선택: 학교 사이트 iframe 삽입을 허용할 출처(공백 구분, 빌드 시 반영). 예: https://lip.center
ALLOWED_FRAME_ANCESTORS=
# 선택: on이면 API 경로·상태·소요시간·오류 코드만 기록한다(본문·원문·좌표는 기록하지 않음).
API_ACCESS_LOG=
