      "get": {
        "summary": "Operator overview: counts by status/category and latest opinion locations (active operator)",
        "responses": {
          "200": {
            "description": "Overview (items: newest first, at most 1000; preview = first 80 chars of the original)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "counts": {
                      "type": "object"
                    },
                    "by_category": {
                      "type": "object"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "limit": {
                      "type": "integer"
                    }
                  },
                  "required": [
