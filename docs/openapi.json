    "/api/opinions": {
      "post": {
        "operationId": "submitOpinion",
        "summary": "Anonymous submission without user account",
        "description": "Same-origin. Maximum 8KB JSON. Same key and canonical payload returns same receipt; different payload returns409. No raw lat/lon accepted. DB enforces configured region, consent, rate limit and receipt transaction.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          }
        },
        "responses": {
